# ==============================================================================
# Django Environment Configuration (.env.example)
#
# Copy this file to '.env' in the project root and populate with your configuration.
# WARNING: Do NOT commit '.env' containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------

# Unique cryptographic key used for session signing and security.
# Generate a new key in Python:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Toggles debug mode.
# Set to 'True' for local development; ALWAYS set to 'False' in production!
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# Local dev: ALLOWED_HOSTS=127.0.0.1,localhost
# Production: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF-protected requests (e.g. POST/PATCH).
# Required when accessing site via custom domains or over HTTPS.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------

# Database connection URL.
# Local SQLite default: sqlite:///db.sqlite3
# Production PostgreSQL example: postgresql://db_user:db_password@localhost:5432/direct_chat_db
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# 3. Django Channels & Redis Configuration
# ------------------------------------------------------------------------------

# Backend type for Django Channels message layer.
# Options: 'inmemory' (for single-process local development) or 'redis' (for multi-worker production)
CHANNEL_LAYER=inmemory

# Redis connection string used by Channels when CHANNEL_LAYER=redis.
# Default local Redis: redis://127.0.0.1:6379/0
# Redis with authentication: redis://:password@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
